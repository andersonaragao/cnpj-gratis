{
    "name": "andersonaragao/cnpj-gratis",
    "description": "Com esse pacote você poderá consultar, gratuitamente, CNPJs diretamente no site da receita.",
    "keywords": ["consulta", "receita", "cnpj", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "Anderson Chaves"
        }
    ],
    "require": {
        "php": ">8.1",
        "ext-gd":"*",
        "ext-curl":"*",
        "symfony/browser-kit": "7.3.x-dev",
        "jansenfelipe/utils": "^2.0@dev"
    },
    "autoload": {
        "psr-4": {
            "AndersonAragao\\CnpjGratis\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    },
    "minimum-stability": "dev"
}
